{
  "name": "@goassay-ai/sdk",
  "version": "0.2.1",
  "description": "Call tools through Assay over MCP, with free and paid calls signed by your own key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assay-ai/assay-sdk.git",
    "directory": "node"
  },
  "homepage": "https://docs.goassay.ai/developers",
  "bugs": {
    "url": "https://github.com/assay-ai/assay-sdk/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./vectors/*": "./vectors/*"
  },
  "files": [
    "dist",
    "vectors",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"const fs = require('node:fs'); fs.rmSync('vectors', { recursive: true, force: true }); fs.cpSync('../vectors', 'vectors', { recursive: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "viem": "2.57.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "viem": ">=2"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  }
}
